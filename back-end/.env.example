# FastAPI
APP_NAME=SCENARA API
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL（API + Celery 共用；独立库，不要用别人的业务库）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/scenara
# 单机调试仍可用：sqlite+aiosqlite:///./data/app.db

# JWT（生产环境 DEBUG=false 时必须改为随机字符串）
JWT_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 已有 MinIO 实例（按实际地址修改）
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bigbanana-media
S3_REGION=us-east-1
S3_USE_SSL=false

# Redis（Celery 等；ComfyUI GPU 锁默认关闭，见 COMFYUI_GPU_LOCK_ENABLED）
REDIS_URL=redis://127.0.0.1:6379/0

# 可选：全局默认 API Key（云端模型 fallback）
DEFAULT_API_KEY=

# API易（gpt-image-2 / 2.5；写入 model_registry 的 apiyi provider）
APIYI_BASE_URL=https://api.apiyi.com
APIYI_API_KEY=

# ---------- 本地推理配置（写入 model_registry，前端从 GET /v1/settings/models 拉取）----------

# vLLM（OpenClaw 对齐）
VLLM_BASE_URL=http://100.64.0.32:8000/v1
VLLM_API_KEY=VLLM_API_KEY
VLLM_MODEL_ID=Qwen/Qwen3.8-27B-FP8
VLLM_MAX_TOKENS=32768

# IndexTTS（OpenClaw 对齐）
# 不要带尾部 /v1（模型 endpoint 已是 /v1/audio/speech）
INDEXTTS_BASE_URL=http://100.64.0.35:8002
INDEXTTS_API_KEY=local
INDEXTTS_MODEL_ID=indextts
INDEXTTS_DEFAULT_VOICE=EL_Danielle_Gentle_Engaging
INDEXTTS_RESPONSE_FORMAT=opus
INDEXTTS_TIMEOUT_MS=120000

# ComfyUI
COMFYUI_BASE_URL=http://100.64.0.35:8188
# 多 worker 且需要互斥占 GPU 时再设为 true；单实例 Comfy 建议 false（避免死锁）
COMFYUI_GPU_LOCK_ENABLED=false

# 默认激活模型 ID
DEFAULT_CHAT_MODEL_ID=qwen3-8-27b-fp8-vllm
DEFAULT_IMAGE_MODEL_ID=comfyui-flux-dev-fp8
DEFAULT_VIDEO_MODEL_ID=comfyui-minimax-h3-flft2v
DEFAULT_AUDIO_MODEL_ID=indextts-local

# CORS（Next.js :3000；nginx 入口 :3080）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.178:3000,http://localhost:3080,http://127.0.0.1:3080,http://192.168.1.178:3080

# 媒体落盘目录（nginx 直出同一路径）。生成图/视频 URL 仍是 /api/v1/media/raw/...
# MEDIA_BACKEND=local
# MEDIA_LOCAL_DIR=./data/media
# MEDIA_URL_PREFIX=/api
