# FastAPI
APP_NAME=AI Director API
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# SQLite（本地文件，相对 back-end 目录）
DATABASE_URL=sqlite+aiosqlite:///./data/bigbanana.db

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 已有 MinIO 实例（按实际地址修改）
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bigbanana-media
S3_REGION=us-east-1
S3_USE_SSL=false

# 已有 Redis 实例（Celery / SSE 进度，按实际地址修改）
REDIS_URL=redis://127.0.0.1:6379/0

# 可选：服务端默认 API Key（用户未配置 settings 时使用）
DEFAULT_API_KEY=

# CORS（Next.js 开发地址）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
